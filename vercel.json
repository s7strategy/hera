{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/HERA-Apresentacao-v7",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s7ponto",
      "destination": "/s7ponto/index.html"
    },
    {
      "source": "/s7ponto/",
      "destination": "/s7ponto/index.html"
    },
    {
      "source": "/livre",
      "destination": "/HERA-Apresentacao-v7"
    },
    {
      "source": "/livre/",
      "destination": "/HERA-Apresentacao-v7"
    }
  ],
  "headers": [
    {
      "source": "/s7ponto/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
