# Copiar para .env e preencher. NUNCA commitar o .env.

# --- Google Places (New) --- unica fonte que custa dinheiro
GOOGLE_PLACES_API_KEY=

# --- Supabase --- opcional; sem isso o pipeline exporta so para arquivo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- OSRM --- publico por padrao; troque por instancia local se for rodar o Brasil inteiro
OSRM_BASE_URL=https://router.project-osrm.org

# --- Cache --- TTL em horas por fonte (0 = nunca expira)
CACHE_TTL_HORAS_IBGE=720
CACHE_TTL_HORAS_CNES=720
CACHE_TTL_HORAS_OSRM=0
CACHE_TTL_HORAS_PLACES=0

# --- Rate limit --- requisicoes por segundo por fonte
RPS_IBGE=5
RPS_OSRM=2
RPS_PLACES=5
