# Sem estas variaveis o dashboard le o snapshot estatico em public/data/snapshot.json.
# Com elas, le direto do Supabase (view v_ranking).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basemap opcional. Por padrao o mapa nao usa tiles: desenha so a malha
# municipal sobre fundo escuro — zero custo e funciona offline.
VITE_BASEMAP_STYLE=

# ---------------------------------------------------------------- Sincronizar
# Estas NAO levam prefixo VITE_ de proposito: sao lidas pela funcao serverless
# em api/sincronizar.ts e nunca chegam ao navegador. Quem tem o token pode rodar
# workflows no repositorio, entao ele nao pode virar bundle.
#
# Token fine-grained com permissao "Actions: read and write" NESTE repositorio
# e em mais nada. Sem ele a aba Sincronizar explica o que falta e nao mostra
# botao que nao funciona.
GITHUB_TOKEN=
GITHUB_REPO=s7strategy/hera
# Branch onde o workflow roda e onde o snapshot atualizado e commitado.
GITHUB_REF_SINCRONIZACAO=main
