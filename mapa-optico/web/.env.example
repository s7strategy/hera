# Sem estas variaveis o dashboard le o snapshot estatico em public/data/snapshot.json.
# Com elas, le direto do Supabase (view v_ranking).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basemap opcional. Por padrao o mapa nao usa tiles: desenha so a malha
# municipal sobre fundo escuro — zero custo e funciona offline.
VITE_BASEMAP_STYLE=
